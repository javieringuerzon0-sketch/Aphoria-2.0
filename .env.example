# Aphoria Beauty — Environment Variables
# Copy this file to .env (local) and configure each variable in Vercel for production.

# ─── Client-side (browser-exposed, VITE_*) ────────────────────────────────────
VITE_META_PIXEL_ID=1672971890715223
VITE_OMNISEND_API_KEY=                  # only used by client newsletter flow
VITE_NEWSLETTER_PROXY_URL=/api/newsletter
VITE_BUNDLE_DISCOUNT_CODE=APHORIA-BUNDLE

# ─── Stripe (server-only) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── PayPal (server-only) ─────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live                        # live | sandbox
PAYPAL_WEBHOOK_ID=

# ─── Omnisend (server-only — Orders + Events scopes) ──────────────────────────
OMNISEND_API_KEY=

# ─── Meta CAPI (server-side conversions API) ──────────────────────────────────
META_PIXEL_ID=1672971890715223
META_CAPI_ACCESS_TOKEN=

# ─── CJDropshipping fulfillment ───────────────────────────────────────────────
CJ_API_KEY=
CJ_VID_REF_GOLD_S=                      # CJ vid reference: 24K Gold Mask single
CJ_VID_REF_GOLD_M=                      # CJ vid reference: 24K Gold Mask multi-pack
CJ_VID_REF_AVO_S=                       # CJ vid reference: Avocado Mask single
